{
  "name": "@exxat/ui",
  "version": "27.7.10-beta",
  "description": "The Common React UI Utilities For Exxat Products (One, Network, Talent).",
  "type": "module",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "files": [
    "./"
  ],
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "index": [
        "types/index.d.ts"
      ],
      "*": [
        "types/*"
      ]
    }
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build:app": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "build": "node --max-old-space-size=8192 ./node_modules/rollup/dist/bin/rollup -c --bundleConfigAsCjs",
    "build:lib": "rollup -c --bundleConfigAsCjs",
    "build:tailwindcss": "npx tailwindcss -i ./styles/styles.css -o ./.storybook/output.css",
    "watch:tailwindcss": "npm run build:tailwindcss --watch",
    "clean:mac": "rm -rf node_modules && rm -rf dist && rm -rf test-results && rm -rf playwright-report && rm -rf .next && rm -rf .cache && rm -rf .rollup.cache",
    "clean:windows": "rd /s /q node_modules && rd /s /q dist && rd /s /q test-results && rd /s /q playwright-report && rd /s /q .next && rd /s /q .cache && rd /s /q .rollup.cache",
    "storybook": "storybook dev -p 6006",
    "watch:storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "format": "prettier --write .",
    "sb": "npm run storybook",
    "pw:test": "playwright test",
    "pw:ui": "npx playwright test --ui",
    "pw:report": "playwright show-report",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "postbuild": "node scripts/update-package-after-build.cjs",
    "prepare": "husky"
  },
